{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EDY Sentinel",
  "version": "1.0.0-rc.1",
  "identifier": "com.edy.sentinel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec vite --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EDY Sentinel",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "edy",
    "copyright": "Copyright © 2026 EDY Sentinel contributors",
    "category": "Utility",
    "shortDescription": "Local-first Windows security observability",
    "longDescription": "EDY Sentinel provides local Windows telemetry, behavioral baselines, explainable detections, conservative vulnerability intelligence, and an auditable Security Score.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "1.0.0.1",
        "upgradeCode": "229d16f0-7d28-522e-8cc0-6a06750db9a7"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
